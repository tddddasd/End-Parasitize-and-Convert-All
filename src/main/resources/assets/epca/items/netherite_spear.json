{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "fixed"],
          "model": {
            "type": "minecraft:model",
            "model": "epca:item/netherite_spear"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "epca:item/netherite_spear_throwing"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "fixed"],
          "model": {
            "type": "minecraft:model",
            "model": "epca:item/netherite_spear"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "epca:item/netherite_spear_in_hand"
      }
    }
  }
}